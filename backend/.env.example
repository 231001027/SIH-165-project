# Copy this file to backend/.env and adjust as needed.
# The application works out of the box with ONLY the defaults below --
# nothing here is required to run the demo.

# --- Database ----------------------------------------------------------
# Default: local SQLite file, zero external infrastructure required.
# For a Postgres/pgvector pilot deployment (see ../docker-compose.yml):
#   DATABASE_URL=postgresql+psycopg2://sifguard:sifguard@localhost:5432/sifguard
DATABASE_URL=sqlite:///./sifguard.db

# --- Auth ----------------------------------------------------------------
# CHANGE THIS before any real deployment. Any long random string works for
# the hackathon demo.
JWT_SECRET=change-this-secret-in-production-CHANGE-ME
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- Optional bounded LLM assistance -------------------------------------
# Leave LLM_PROVIDER empty to run entirely on the deterministic rule engine +
# local ML pipeline (fully offline-safe). Supported providers: ollama, anthropic.
# Local Ollama (non-Docker):
#   LLM_PROVIDER=ollama
#   LLM_API_KEY=ollama
#   LLM_MODEL=llama3:latest
#   OLLAMA_BASE_URL=http://127.0.0.1:11434
# Docker Compose sets OLLAMA_BASE_URL=http://ollama:11434 automatically.
LLM_PROVIDER=ollama
LLM_API_KEY=ollama
LLM_MODEL=llama3:latest
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Embeddings ------------------------------------------------------------
# Default: multilingual Sentence-Transformers (cross-lingual retrieval).
# Cold-start downloads ~120MB of weights on first run — pre-download before offline demos:
#   python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('paraphrase-multilingual-MiniLM-L12-v2')"
# Fully offline fallback (English TF-IDF+SVD, not cross-lingual):
#   EMBEDDING_MODEL=tfidf-svd-local
# Rule NLP stays English-only regardless of this setting.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- CORS ------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# --- Hi-Po / HIGH push alerts ----------------------------------------------
# mock = console log (default for hackathon). smtp = real SMTP when configured.
NOTIFY_MODE=mock
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=sifguard-alerts@localhost
